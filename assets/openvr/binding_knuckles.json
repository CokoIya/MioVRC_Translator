{
  "action_manifest_version": 0,
  "alias_info": {},
  "app_key": "mio.translator.overlay",
  "bindings": {
    "/actions/mio": {
      "haptics": [
        {
          "output": "/actions/mio/out/haptic",
          "path": "/user/hand/left/output/haptic"
        },
        {
          "output": "/actions/mio/out/haptic",
          "path": "/user/hand/right/output/haptic"
        }
      ],
      "poses": [
        {
          "output": "/actions/mio/in/pointer_left",
          "path": "/user/hand/left/pose/tip"
        },
        {
          "output": "/actions/mio/in/pointer_right",
          "path": "/user/hand/right/pose/tip"
        }
      ],
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/translate_screen"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/b"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/translate_screen"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/b"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/hold_trigger"
            },
            "pull": {
              "output": "/actions/mio/in/trigger_value"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/hold_grip"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/grip"
        },
        {
          "inputs": {
            "force": {
              "output": "/actions/mio/in/grip_value"
            }
          },
          "mode": "force_sensor",
          "path": "/user/hand/left/input/grip"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/hold_trigger"
            },
            "pull": {
              "output": "/actions/mio/in/trigger_value"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/hold_grip"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/grip"
        },
        {
          "inputs": {
            "force": {
              "output": "/actions/mio/in/grip_value"
            }
          },
          "mode": "force_sensor",
          "path": "/user/hand/right/input/grip"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/any_button"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/a"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/any_button"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/a"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/any_button"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/thumbstick"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio/in/any_button"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/thumbstick"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/mio/in/stick"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/left/input/thumbstick"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/mio/in/stick"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/right/input/thumbstick"
        }
      ]
    },
    "/actions/mio_block": {
      "sources": [
        {
          "inputs": {
            "click": {
              "output": "/actions/mio_block/in/trigger"
            },
            "pull": {
              "output": "/actions/mio_block/in/trigger_value"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/left/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio_block/in/grip"
            }
          },
          "mode": "button",
          "path": "/user/hand/left/input/grip"
        },
        {
          "inputs": {
            "force": {
              "output": "/actions/mio_block/in/grip_value"
            }
          },
          "mode": "force_sensor",
          "path": "/user/hand/left/input/grip"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio_block/in/trigger"
            },
            "pull": {
              "output": "/actions/mio_block/in/trigger_value"
            }
          },
          "mode": "trigger",
          "path": "/user/hand/right/input/trigger"
        },
        {
          "inputs": {
            "click": {
              "output": "/actions/mio_block/in/grip"
            }
          },
          "mode": "button",
          "path": "/user/hand/right/input/grip"
        },
        {
          "inputs": {
            "force": {
              "output": "/actions/mio_block/in/grip_value"
            }
          },
          "mode": "force_sensor",
          "path": "/user/hand/right/input/grip"
        }
      ]
    },
    "/actions/mio_block_stick": {
      "sources": [
        {
          "inputs": {
            "position": {
              "output": "/actions/mio_block_stick/in/stick"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/left/input/thumbstick"
        },
        {
          "inputs": {
            "position": {
              "output": "/actions/mio_block_stick/in/stick"
            }
          },
          "mode": "joystick",
          "path": "/user/hand/right/input/thumbstick"
        }
      ]
    }
  },
  "controller_type": "knuckles",
  "description": "Hold trigger + grip, then press B (right) or Y (left) to translate what you are looking at. Any other button puts a shown translation away.",
  "name": "Mio Translator defaults",
  "options": {},
  "simulated_actions": []
}
